namespace std {

template <class A, class B>
struct pair {
    A first;
    B second;
};

template <class K, class V>
class map {
public:
    typedef pair<const K, V> value_type;
    class iterator {
    public:
        value_type* operator->() const;
        bool operator!=(const iterator& other) const;

    private:
        void* _M_node;
    };

    iterator begin();
    iterator end();
    void erase(iterator it);
    V& operator[](const K& key);
    map();
    ~map();
    unsigned size() const;

private:
    int _M_impl[6];
};

}  // namespace std
