set(CMAKE_SYSTEM_NAME Darwin)

get_filename_component(_medecomp_root ${CMAKE_CURRENT_LIST_DIR}/../.. ABSOLUTE)
if(NOT MEDECOMP_MAC_ARCH)
    set(MEDECOMP_MAC_ARCH arm64 CACHE STRING "arm64 (Apple Silicon) или x86_64 (Intel)")
endif()
if(NOT MEDECOMP_MAC_MIN)
    set(MEDECOMP_MAC_MIN 12.0 CACHE STRING "Самая старая macOS")
endif()
if(NOT MEDECOMP_OSXCROSS)
    if(DEFINED ENV{OSXCROSS_TARGET_DIR})
        set(MEDECOMP_OSXCROSS $ENV{OSXCROSS_TARGET_DIR} CACHE PATH "osxcross/target")
    else()
        set(MEDECOMP_OSXCROSS $ENV{HOME}/osxcross/target CACHE PATH "osxcross/target")
    endif()
endif()
if(NOT MEDECOMP_MAC_SYSROOT)
    set(MEDECOMP_MAC_SYSROOT ${_medecomp_root}/build/mac/sysroot-${MEDECOMP_MAC_ARCH} CACHE PATH
        "Библиотеки MacPorts (tools/mac_deps.py)")
endif()
file(GLOB _cxx ${MEDECOMP_OSXCROSS}/bin/${MEDECOMP_MAC_ARCH}-apple-darwin*-clang++)
file(GLOB _sdk LIST_DIRECTORIES true ${MEDECOMP_OSXCROSS}/SDK/MacOSX*.sdk)
if(NOT _cxx OR NOT _sdk)
    message(FATAL_ERROR "Нет osxcross с SDK macOS (MEDECOMP_OSXCROSS=${MEDECOMP_OSXCROSS})")
endif()
if(NOT EXISTS ${MEDECOMP_MAC_SYSROOT}/opt/local/lib/pkgconfig)
    message(FATAL_ERROR "Нет библиотек MacPorts в ${MEDECOMP_MAC_SYSROOT}: python3 -I tools/mac_deps.py --arch ${MEDECOMP_MAC_ARCH}")
endif()
list(GET _cxx 0 _cxx)
list(GET _sdk 0 _sdk)
string(REGEX REPLACE "-clang\\+\\+$" "" _host ${_cxx})
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES MEDECOMP_OSXCROSS MEDECOMP_MAC_ARCH MEDECOMP_MAC_MIN MEDECOMP_MAC_SYSROOT)

set(CMAKE_SYSTEM_PROCESSOR ${MEDECOMP_MAC_ARCH})
set(CMAKE_C_COMPILER ${_host}-clang)
set(CMAKE_CXX_COMPILER ${_host}-clang++)
set(CMAKE_OBJC_COMPILER ${_host}-clang)
set(CMAKE_OBJCXX_COMPILER ${_host}-clang++)
set(CMAKE_AR ${_host}-ar CACHE FILEPATH "ar")
set(CMAKE_RANLIB ${_host}-ranlib CACHE FILEPATH "ranlib")
set(CMAKE_NM ${_host}-nm CACHE FILEPATH "nm")
set(CMAKE_INSTALL_NAME_TOOL ${_host}-install_name_tool CACHE FILEPATH "install_name_tool")
set(CMAKE_OSX_SYSROOT ${_sdk} CACHE PATH "SDK macOS")
set(CMAKE_OSX_ARCHITECTURES ${MEDECOMP_MAC_ARCH} CACHE STRING "")
set(CMAKE_OSX_DEPLOYMENT_TARGET ${MEDECOMP_MAC_MIN} CACHE STRING "")

set(CMAKE_FIND_ROOT_PATH ${MEDECOMP_MAC_SYSROOT}/opt/local ${_sdk})
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

set(ENV{PKG_CONFIG_LIBDIR} ${MEDECOMP_MAC_SYSROOT}/opt/local/lib/pkgconfig:${MEDECOMP_MAC_SYSROOT}/opt/local/share/pkgconfig)
set(ENV{PKG_CONFIG_PATH} "")
set(ENV{PKG_CONFIG_SYSROOT_DIR} ${MEDECOMP_MAC_SYSROOT})
