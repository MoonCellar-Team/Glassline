set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)

get_filename_component(_medecomp_root ${CMAKE_CURRENT_LIST_DIR}/../.. ABSOLUTE)
if(NOT MEDECOMP_MINGW)
    file(GLOB _mingw LIST_DIRECTORIES true ${_medecomp_root}/build/win/llvm-mingw-*)
    list(SORT _mingw)
    list(REVERSE _mingw)
    list(GET _mingw 0 _mingw)
    set(MEDECOMP_MINGW ${_mingw} CACHE PATH "llvm-mingw")
endif()
if(NOT MEDECOMP_WIN_SYSROOT)
    set(MEDECOMP_WIN_SYSROOT ${_medecomp_root}/build/win/sysroot CACHE PATH "Библиотеки MSYS2 clang64 (tools/win_deps.py)")
endif()
if(NOT EXISTS ${MEDECOMP_MINGW}/bin/x86_64-w64-mingw32-clang++)
    message(FATAL_ERROR "Нет llvm-mingw (MEDECOMP_MINGW=${MEDECOMP_MINGW})")
endif()
if(NOT EXISTS ${MEDECOMP_WIN_SYSROOT}/clang64/lib/pkgconfig)
    message(FATAL_ERROR "Нет библиотек MSYS2 в ${MEDECOMP_WIN_SYSROOT}: python3 -I tools/win_deps.py")
endif()
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES MEDECOMP_MINGW MEDECOMP_WIN_SYSROOT MEDECOMP_EXTRA_FIND_ROOT)

set(CMAKE_C_COMPILER ${MEDECOMP_MINGW}/bin/x86_64-w64-mingw32-clang)
set(CMAKE_CXX_COMPILER ${MEDECOMP_MINGW}/bin/x86_64-w64-mingw32-clang++)
set(CMAKE_RC_COMPILER ${MEDECOMP_MINGW}/bin/x86_64-w64-mingw32-windres)

set(CMAKE_FIND_ROOT_PATH ${MEDECOMP_WIN_SYSROOT}/clang64 ${MEDECOMP_MINGW}/x86_64-w64-mingw32 ${MEDECOMP_EXTRA_FIND_ROOT})
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

set(_medecomp_pc_sysroot ${MEDECOMP_WIN_SYSROOT})
if(_medecomp_pc_sysroot MATCHES "[ \t]")
    string(MD5 _hash "${_medecomp_pc_sysroot}")
    string(SUBSTRING "${_hash}" 0 12 _hash)
    set(_base "$ENV{XDG_CACHE_HOME}")
    if(NOT _base)
        set(_base "$ENV{HOME}/.cache")
    endif()
    if(_base MATCHES "[ \t]" OR _base STREQUAL "/.cache")
        set(_base "/tmp")
    endif()
    file(MAKE_DIRECTORY "${_base}/medecomp")
    set(_link "${_base}/medecomp/sysroot-${_hash}")
    if(IS_SYMLINK "${_link}")
        file(READ_SYMLINK "${_link}" _target)
        if(NOT "${_target}" STREQUAL "${_medecomp_pc_sysroot}")
            message(FATAL_ERROR "${_link} ведёт в ${_target}, ожидался ${_medecomp_pc_sysroot}")
        endif()
    elseif(EXISTS "${_link}")
        message(FATAL_ERROR "Путь для ссылки sysroot уже занят: ${_link}")
    else()
        file(CREATE_LINK "${_medecomp_pc_sysroot}" "${_link}" SYMBOLIC)
    endif()
    set(_medecomp_pc_sysroot "${_link}")
endif()
set(ENV{PKG_CONFIG_LIBDIR} ${_medecomp_pc_sysroot}/clang64/lib/pkgconfig)
set(ENV{PKG_CONFIG_PATH} "")
set(ENV{PKG_CONFIG_SYSROOT_DIR} ${_medecomp_pc_sysroot})
