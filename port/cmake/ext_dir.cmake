include_guard(GLOBAL)

if(CMAKE_BINARY_DIR MATCHES "[ \t]")
    string(MD5 _hash "${CMAKE_BINARY_DIR}")
    string(SUBSTRING "${_hash}" 0 12 _hash)
    set(_base "$ENV{XDG_CACHE_HOME}")
    if(NOT _base)
        set(_base "$ENV{HOME}/.cache")
    endif()
    if(_base MATCHES "[ \t]" OR _base STREQUAL "/.cache")
        set(_base "/tmp")
    endif()
    set(MEDECOMP_EXT_DIR "${_base}/medecomp/ext-${_hash}")
    file(MAKE_DIRECTORY "${MEDECOMP_EXT_DIR}")
    message(STATUS "Путь сборки с пробелом: FFmpeg, OpenSSL, protobuf и GameNetworkingSockets — в ${MEDECOMP_EXT_DIR}")
else()
    set(MEDECOMP_EXT_DIR "${CMAKE_BINARY_DIR}")
endif()

function(medecomp_nospace out path)
    if(NOT path MATCHES "[ \t]")
        set(${out} "${path}" PARENT_SCOPE)
        return()
    endif()
    get_filename_component(_dir "${path}" DIRECTORY)
    get_filename_component(_name "${path}" NAME)
    string(MD5 _hash "${_dir}")
    string(SUBSTRING "${_hash}" 0 12 _hash)
    set(_link "${MEDECOMP_EXT_DIR}/tools/${_hash}")
    file(MAKE_DIRECTORY "${MEDECOMP_EXT_DIR}/tools")
    file(CREATE_LINK "${_dir}" "${_link}" SYMBOLIC)
    set(${out} "${_link}/${_name}" PARENT_SCOPE)
endfunction()
