if(NOT DEFINED ENV{EMSDK})
    message(FATAL_ERROR "Нет emsdk в окружении: source ~/emsdk/emsdk_env.sh")
endif()
include($ENV{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake)

get_filename_component(_medecomp_root ${CMAKE_CURRENT_LIST_DIR}/../.. ABSOLUTE)
if(NOT MEDECOMP_WEB_SYSROOT)
    set(MEDECOMP_WEB_SYSROOT ${_medecomp_root}/build/web/sysroot CACHE PATH "pixman и cairo для браузера (tools/web_deps.py)")
endif()
if(NOT EXISTS ${MEDECOMP_WEB_SYSROOT}/lib/pkgconfig/cairo.pc)
    message(FATAL_ERROR "Нет cairo для браузера в ${MEDECOMP_WEB_SYSROOT}: python3 -I tools/web_deps.py")
endif()
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES MEDECOMP_WEB_SYSROOT)
set(ENV{PKG_CONFIG_PATH} "")
set(CMAKE_C_FLAGS_INIT "-pthread")
set(CMAKE_CXX_FLAGS_INIT "-pthread")
