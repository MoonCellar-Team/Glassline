file(MAKE_DIRECTORY ${CMAKE_BINARY_DIR}/gen)

if(PKG_CONFIG_FOUND)
    pkg_check_modules(PKG_openal QUIET openal)
endif()
if(PKG_openal_FOUND)
    medecomp_pkg(openal)
elseif(MEDECOMP_M32)
    find_library(MEDECOMP_OPENAL32 NAMES openal libopenal.so.1
        PATHS /usr/lib/i386-linux-gnu /usr/lib/i686-linux-gnu /usr/lib32 /usr/lib NO_DEFAULT_PATH)
    if(NOT MEDECOMP_OPENAL32)
        message(FATAL_ERROR "Нужен 32-битный OpenAL Soft: libopenal1:i386 или openal-soft.i686")
    endif()
    list(APPEND MEDECOMP_LINK_FLAGS ${MEDECOMP_OPENAL32})
else()
    find_library(MEDECOMP_OPENAL NAMES openal libopenal.so.1)
    if(NOT MEDECOMP_OPENAL)
        message(FATAL_ERROR "Нужен OpenAL Soft: libopenal-dev или openal-soft-devel")
    endif()
    list(APPEND MEDECOMP_LINK_FLAGS ${MEDECOMP_OPENAL})
endif()

option(MEDECOMP_FFMPEG_BUNDLE "FFmpeg из исходников рядом с игрой" ON)
if(MEDECOMP_FFMPEG_BUNDLE AND NOT MEDECOMP_M32)
    include(${CMAKE_CURRENT_LIST_DIR}/ffmpeg.cmake)
    set(PKG_ffmpeg_FOUND ON)
    set(PKG_ffmpeg_LDFLAGS)
    set(PKG_ffmpeg_INCLUDE_DIRS)
    set(PKG_ffmpeg_CFLAGS_OTHER)
elseif(PKG_CONFIG_FOUND)
    pkg_check_modules(PKG_ffmpeg QUIET libavformat libavcodec libswresample libavutil)
endif()
if(PKG_ffmpeg_FOUND)
    list(APPEND MEDECOMP_LINK_FLAGS ${PKG_ffmpeg_LDFLAGS})
    list(APPEND MEDECOMP_INCLUDE_DIRS ${PKG_ffmpeg_INCLUDE_DIRS})
    list(APPEND MEDECOMP_CFLAGS ${PKG_ffmpeg_CFLAGS_OTHER})
    set_source_files_properties(${CMAKE_CURRENT_LIST_DIR}/decode.cpp ${CMAKE_CURRENT_LIST_DIR}/music.cpp
                                PROPERTIES COMPILE_DEFINITIONS MEDECOMP_FFMPEG=1)
else()
    message(WARNING "Нет FFmpeg (libavformat-dev libavcodec-dev libswresample-dev): музыка игры играть не будет")
endif()
